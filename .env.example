# --- smtp-to-matrix configuration (target room must be UNENCRYPTED) ---
#
# The server reads these from the environment. For development, copy this file
# to .env and export it into your shell (e.g. `set -a; . ./.env; set +a`)
# before `uv run smtp-to-matrix`.

# Base URL of the Matrix homeserver (required).
MATRIX_HOMESERVER_URL=https://matrix.example.org

# Target room: internal id (!id:server or !id depending on the instance)
# or alias (#name:server) (required).
MATRIX_ROOM_ID=!roomid:example.org

# Authentication — provide EITHER an access token (preferred) OR login + pass.
# A ready access token; takes precedence over MATRIX_LOGIN/MATRIX_PASS.
# MATRIX_ACCESS_TOKEN=

# Password-login fallback, used only when MATRIX_ACCESS_TOKEN is unset.
MATRIX_LOGIN=
MATRIX_PASS=

# SMTP listener bind address (optional). Defaults below.
# Port 25 requires root or CAP_NET_BIND_SERVICE.
SMTP_HOST=0.0.0.0
SMTP_PORT=25

# Label shown on the `Host:` line of each forwarded message (optional).
# Defaults to the machine's hostname when unset.
# MATRIX_HOST_LABEL=

# Path to the batching config (optional). When unset, every mail is sent
# immediately as a summary line with its full body threaded underneath.
# See config.example.yaml.
# CONFIG_PATH=config.yaml

# SQLite file holding batched mail until each batch's digest is flushed
# (optional). Defaults to pending_mail.db in the working directory.
# DB_PATH=pending_mail.db
